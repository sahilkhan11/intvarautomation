<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the requested path exists as a file or directory, serve it natively
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If the requested path + .html exists, rewrite to the .html file
  # This fixes the "Page Not Found" error on refresh for Next.js static exports
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Handle 404 page correctly
ErrorDocument 404 /404.html
